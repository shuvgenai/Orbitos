# The separate landing-page repo, if it is ever cloned in here.
# ANCHORED with a leading slash on purpose: an unanchored `landing/` matches a directory of
# that name at ANY depth, which silently swallowed src/apps/landing/ and
# dashboards/landing/ -- the whole root page (FD-29) was invisible to git and would never
# have been committed.
/landing/

# Secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db

# Dependencies and generated code
node_modules/
**/generated/

# Vitest cache
.vitest/

# Vite build output
dist/

# Playwright
e2e/shots/
test-results/
playwright-report/
