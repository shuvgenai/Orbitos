{
  "name": "orbit-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "db:up": "node scripts/dev-db.mjs up -d --wait",
    "db:down": "node scripts/dev-db.mjs down -v",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "pnpm --filter @orbit/db exec prisma generate",
    "db:migrate": "pnpm --filter @orbit/db exec prisma migrate deploy",
    "stack:up": "docker compose -f template/compose.yml up -d --build --wait",
    "stack:down": "docker compose -f template/compose.yml down -v",
    "resend:check": "pnpm --filter @orbit/ops exec node --env-file=../.env.local --import tsx src/send-resend-check.ts",
    "posture:check": "pnpm --filter @orbit/ops exec node --import tsx src/posture-check.ts",
    "spike:run": "pnpm --filter @orbit/ops exec node --import tsx src/spike/run-spike.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "lint": "oxlint --deny-warnings src vite.config.ts tailwind.config.ts",
    "test:web": "vitest run --project web"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "autoprefixer": "10.6.2",
    "jsdom": "31.0.0",
    "oxlint": "1.91.0",
    "pg": "8.23.1",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "7.0.3",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-query": "5.106.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "zod": "4.6.5"
  }
}
