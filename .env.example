# Copy to .env.local and fill in. .env.local is git-ignored; this file is not, so it carries no
# real values.

# The Postgres host port for the local dev stack (compose.dev.yml). Leave unset to use 5432.
# On a machine where another Postgres already owns 5432 — a native Windows service, say — set a
# free port here. Both `pnpm db:up` and the db tests read this one setting: db:up through
# scripts/dev-db.mjs, the tests through vitest.config.ts.
ORBIT_DB_HOST_PORT=5433

# Must match ORBIT_DB_HOST_PORT above. The database name has to end in _test, or the db test
# global setup refuses to reset it.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/orbit_test

ANTHROPIC_API_KEY=
ENGINE_ANTHROPIC_API_KEY=
RESEND_API_KEY=
TYPESAFE_API_KEY=
